# Copy to .env.local and fill in. Names only — never commit real values.
# docs/RUNBOOK.md explains every switch below.

# --- Client (inlined into the browser bundle at build time; safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical origin, used for metadata and auth redirects (e.g. https://example.com)
NEXT_PUBLIC_SITE_URL=
# Optional: "true" shows a back-soon page on every route except /privacy and /terms (needs a redeploy)
NEXT_PUBLIC_MAINTENANCE_MODE=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret Vercel Cron sends as `Authorization: Bearer ...`; the cron routes refuse everything if unset
CRON_SECRET=
# Used only by /api/cron/update-games
ANTHROPIC_API_KEY=
# Optional: "false" stops the daily game-list update without a code change
GAME_UPDATES_ENABLED=
# Optional per-run caps for the game-list update (defaults are in app/api/cron/update-games/route.ts)
GAME_UPDATES_MAX_GAMES=
GAME_UPDATES_MAX_TOKENS=
# Optional: "enforce" turns the Content-Security-Policy on; anything else leaves it report-only
CSP_MODE=
